# Local development and CI only. Copy to .env.local.
#
# Nothing in this file is a secret. The Supabase keys are the fixed defaults the Supabase
# CLI issues for every local stack (`pnpm db:start`); they are the same on every machine
# and only work against 127.0.0.1. The demo passwords and reset secret are local
# placeholders matching supabase/seed.sql. The deployed demo uses its own random values,
# set in the hosting provider, never committed.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Test-mode key (sk_test_...) from the Stripe dashboard. Only needed to open Checkout.
STRIPE_SECRET_KEY=
# Tests sign webhook payloads with this value. For real test payments, replace it with
# the secret printed by `stripe listen`.
STRIPE_WEBHOOK_SECRET=whsec_local_testing_only

DEMO_ADMIN_EMAIL=admin@fairview.example
DEMO_ADMIN_PASSWORD=local-demo-password
DEMO_TECHNICIAN_EMAIL=alex.moreno@fairview.example
DEMO_TECHNICIAN_PASSWORD=local-demo-password

DEMO_RESET_SECRET=local-reset-secret
